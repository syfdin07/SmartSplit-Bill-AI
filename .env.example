# Environment variables for SmartSplit Bill AI

# OpenAI API (if using GPT-4 Vision)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API (if using Gemini Vision)
GOOGLE_API_KEY=your_google_api_key_here

# Model settings
MODEL_TYPE=local  # Options: local, openai, gemini
MODEL_NAME=donut  # Model name to use

# Application settings
DEBUG=False
MAX_IMAGE_SIZE=10000
MIN_IMAGE_SIZE=100
